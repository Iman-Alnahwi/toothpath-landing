# Copy to `.env` and fill in. Nothing here is committed.

# Shown in the footer and on the WhatsApp button.
NUXT_PUBLIC_CONTACT_PHONE="+9647XXXXXXXXX"
NUXT_PUBLIC_CONTACT_WHATSAPP="9647XXXXXXXXX"
NUXT_PUBLIC_CONTACT_EMAIL="hello@example.com"

# OPTIONAL — the live app's public plans endpoint, e.g.
#   https://app.example.com/api/public/plans
# Set it and prices come from the one place they are edited. Leave it empty and
# the page falls back to config/plans.ts.
NUXT_PUBLIC_PLANS_URL=""

# OPTIONAL — forward each demo request to the live app instead of storing it
# here, e.g. https://app.example.com/api/public/demo
NUXT_DEMO_FORWARD_URL=""
